# ---- Speech (Step 4): Gnani key from https://app.gnani.ai/voice (one key covers STT and TTS)
GNANI_API_KEY=

# ---- LLM: any OpenAI-compatible endpoint (nvidia | groq | cerebras | gemini | openrouter | ollama)
LLM_PROVIDER=nvidia
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
LLM_TPM=0                       # tokens-per-minute pacing; 0 = off

# ---- Retrieval
EMBED_MODEL=intfloat/multilingual-e5-base
TOP_K=26

# ---- Optional voice overrides (defaults shown)
# STT_MODEL=prisma-v3.0
# STT_LANGUAGE=en-IN
# TTS_MODEL=timbre-v2.5
# TTS_VOICE=Kaveri
